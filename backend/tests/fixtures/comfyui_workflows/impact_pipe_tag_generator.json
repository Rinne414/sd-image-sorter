{
  "name": "impact-pipe-two-pass-tag-generator",
  "description": "Owner workflow shape (2026-09-29): prompts ride Impact Pack pipes (ToBasicPipe -> FromBasicPipe -> ToBasicPipe -> FromBasicPipe) into two CFGGuider + SamplerCustomAdvanced passes; the positive is assembled by JoinStringMulti from a prompt UI literal, a TIPO tag generator (runtime output, ban_tags wired from the NEGATIVE prompt) and a WD14 tagger (exclude_tags also from the negative), and a ShowText holds the executed result. The parser must read pipe output slots, must not walk ban/exclude links into the positive, must keep the executed ShowText cache, and must not repeat the prompt once per pass.",
  "prompt_data": {
    "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "animaSample_v1.safetensors"}},
    "10": {"class_type": "WeiLinPromptUIWithoutLora", "inputs": {"positive": "masterpiece, best quality, newest, 1girl,", "auto_random": false}},
    "11": {"class_type": "PromptStudioPositiveOutput", "inputs": {"positive": "worst quality, low quality, jpeg artifacts, watermark, signature", "打开 Prompt Studio": ""}},
    "12": {"class_type": "PromptStudioPositiveOutput", "inputs": {"positive": "artist name, realistic, photo background", "打开 Prompt Studio": ""}},
    "13": {"class_type": "JoinStringMulti", "inputs": {"inputcount": 2, "delimiter": " ", "return_list": false, "string_1": ["11", 0], "string_2": ["12", 0]}},
    "14": {"class_type": "LoadImage", "inputs": {"image": "reference.png"}},
    "15": {"class_type": "WD14Tagger|pysssss", "inputs": {"model": "wd-eva02-large-tagger-v3", "threshold": 0.35, "character_threshold": 0.85, "replace_underscore": true, "trailing_comma": true, "exclude_tags": ["13", 0], "tags": "solo, long hair, red scarf, looking at viewer, ", "image": ["14", 0]}},
    "16": {"class_type": "ShowText|pysssss", "inputs": {"text": ["15", 0], "text_0": "solo, long hair, red scarf, looking at viewer, "}},
    "17": {"class_type": "ShowText|pysssss", "inputs": {"text": ["11", 0], "text_0": "worst quality, low quality, jpeg artifacts, watermark, signature"}},
    "18": {"class_type": "TIPO", "inputs": {"tags": ["16", 0], "nl_prompt": "", "ban_tags": ["17", 0], "tipo_model": "TIPO-v2.1-1B-A200M-f16.gguf", "format": "<|special|>, <|general|>, <|extended|>.", "width": 1024, "height": 1024, "temperature": 0.5, "top_p": 0.95, "min_p": 0.05, "top_k": 95, "tag_length": "long", "nl_length": "short", "seed": 7, "device": "cuda"}},
    "19": {"class_type": "JoinStringMulti", "inputs": {"inputcount": 2, "delimiter": " ", "return_list": false, "string_1": ["10", 0], "string_2": ["18", 0]}},
    "20": {"class_type": "ShowText|pysssss", "inputs": {"text": ["19", 0], "text_0": "masterpiece, best quality, newest, 1girl, solo, long hair, red scarf, looking at viewer, lantern-lit street, evening,"}},
    "21": {"class_type": "CLIPTextEncode", "inputs": {"text": ["20", 0], "clip": ["1", 1]}},
    "22": {"class_type": "CLIPTextEncode", "inputs": {"text": ["11", 0], "clip": ["1", 1]}},
    "30": {"class_type": "ToBasicPipe", "inputs": {"model": ["1", 0], "clip": ["1", 1], "vae": ["1", 2], "positive": ["21", 0], "negative": ["22", 0]}},
    "31": {"class_type": "FromBasicPipe", "inputs": {"basic_pipe": ["30", 0]}},
    "32": {"class_type": "PerturbedAttentionGuidance", "inputs": {"scale": 3.0, "model": ["31", 0]}},
    "33": {"class_type": "ToBasicPipe", "inputs": {"model": ["32", 0], "clip": ["31", 1], "vae": ["31", 2], "positive": ["31", 3], "negative": ["31", 4]}},
    "34": {"class_type": "FromBasicPipe", "inputs": {"basic_pipe": ["33", 0]}},
    "35": {"class_type": "FromBasicPipe", "inputs": {"basic_pipe": ["33", 0]}},
    "40": {"class_type": "CFGGuider", "inputs": {"cfg": 5.0, "model": ["34", 0], "positive": ["34", 3], "negative": ["34", 4]}},
    "41": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "er_sde"}},
    "42": {"class_type": "RandomNoise", "inputs": {"noise_seed": 11}},
    "43": {"class_type": "BasicScheduler", "inputs": {"scheduler": "simple", "steps": 28, "denoise": 1.0, "model": ["34", 0]}},
    "44": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "45": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["42", 0], "guider": ["40", 0], "sampler": ["41", 0], "sigmas": ["43", 0], "latent_image": ["44", 0]}},
    "50": {"class_type": "CFGGuider", "inputs": {"cfg": 5.0, "model": ["35", 0], "positive": ["35", 3], "negative": ["35", 4]}},
    "51": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "uni_pc_bh2"}},
    "52": {"class_type": "RandomNoise", "inputs": {"noise_seed": 12}},
    "53": {"class_type": "BasicScheduler", "inputs": {"scheduler": "simple", "steps": 20, "denoise": 0.45, "model": ["35", 0]}},
    "54": {"class_type": "LatentUpscaleBy", "inputs": {"upscale_method": "nearest-exact", "scale_by": 1.5, "samples": ["45", 0]}},
    "55": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["52", 0], "guider": ["50", 0], "sampler": ["51", 0], "sigmas": ["53", 0], "latent_image": ["54", 0]}},
    "60": {"class_type": "VAEDecode", "inputs": {"samples": ["55", 0], "vae": ["35", 2]}},
    "61": {"class_type": "SaveImage", "inputs": {"filename_prefix": "ComfyUI", "images": ["60", 0]}}
  },
  "expect": {
    "positive_contains": ["masterpiece, best quality, newest, 1girl", "red scarf", "lantern-lit street"],
    "positive_not_contains": ["jpeg artifacts", "photo background"],
    "negative_contains": ["worst quality", "watermark"],
    "checkpoint_contains": "animaSample_v1"
  }
}
